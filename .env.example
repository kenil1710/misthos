# ─── App ────────────────────────────────────────────────────────────────
# Public URL of the web app (used for OAuth callbacks, OG images, links).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Which Arc network to use: arc-testnet | arc-mainnet. See packages/shared/src/chains.ts.
NEXT_PUBLIC_CHAIN=arc-testnet
# Postgres connection string (Neon/Supabase). Needs the pg_trgm extension.
DATABASE_URL=
# 32+ random bytes for signing session cookies. `openssl rand -base64 32`
SESSION_SECRET=

# ─── Arc / chain ───────────────────────────────────────────────────────
# Optional RPC override. Defaults to the public RPC in chains.ts.
ARC_RPC_URL=
# MisthosVaultFactory address, written by `script/Deploy.s.sol` (Phase 1).
VAULT_FACTORY_ADDRESS=

# ─── Circle (Developer-Controlled Wallets; agent executor) ────────────
# API key from console.circle.com (testnet key for arc-testnet).
CIRCLE_API_KEY=
# Entity secret registered with Circle. Never log this.
CIRCLE_ENTITY_SECRET=
# Wallet ID of the agent executor wallet on ARC-TESTNET.
CIRCLE_AGENT_WALLET_ID=

# ─── Anthropic ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Judgment model (structured output via tool use).
AGENT_MODEL_JUDGE=claude-haiku-4-5-20251001
# Cheap pre-screen model.
AGENT_MODEL_FAST=claude-haiku-4-5-20251001

# ─── X (API v2 pay-per-use + OAuth 2.0 PKCE) ───────────────────────────
X_CLIENT_ID=
X_CLIENT_SECRET=
# App-only bearer token for GET /2/tweets/:id lookups.
X_BEARER_TOKEN=

# ─── GitHub ─────────────────────────────────────────────────────────────
# Fine-grained read-only token for PR/commit lookups.
GITHUB_TOKEN=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ─── Optional ───────────────────────────────────────────────────────────
SENTRY_DSN=

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Testnet-only deployer key for `forge script` (Phase 1). Never reuse on mainnet.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Testnet-only agent signer for decision records until the Circle wallet signer lands. Never commit a real value.
AGENT_PRIVATE_KEY=
# Optional: Neon direct (non-pooler) URL for the worker. Derived from DATABASE_URL when unset.
DATABASE_URL_DIRECT=
