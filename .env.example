# Misthos environment. Copy to `.env` in the repo root (gitignored) and fill in.
# Never commit real values. Both the web app and the worker read this one file in local development;
# in production set the same variables on Vercel (web) and Railway (worker).

# ─── App ────────────────────────────────────────────────────────────────
# Public origin of the web app. Used for SIWE domain checks, the X OAuth callback and same-origin POST checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Which Arc network: arc-testnet | arc-mainnet. See packages/shared/src/chains.ts.
NEXT_PUBLIC_CHAIN=arc-testnet
# 32+ random bytes for signing session cookies: `openssl rand -base64 32`
SESSION_SECRET=
# WalletConnect Cloud project id (ConnectKit wallet connections).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Comma-separated owner wallets allowed to open /app/admin/metrics.
FOUNDER_WALLETS=

# ─── Database (Neon Postgres, needs pg_trgm) ───────────────────────────
# Pooled connection string for the web app.
DATABASE_URL=
# Optional: direct (non-pooler) URL for the worker's pg-boss queue. Derived from DATABASE_URL when unset.
DATABASE_URL_DIRECT=
# Optional: max pg connections per process (default 5).
DB_POOL_MAX=

# ─── Arc ───────────────────────────────────────────────────────────────
# Optional RPC override. Defaults to the public RPC in chains.ts. Contract addresses live in
# packages/shared/src/deployments.json (written by the deploy scripts).
ARC_RPC_URL=

# ─── Agent wallet (Circle Developer-Controlled Wallets, ARC-TESTNET) ──
# Testnet API key from console.circle.com. `pnpm --filter @misthos/worker circle:setup` fills the next three.
CIRCLE_API_KEY=
# Entity secret registered with Circle. Never log it. Recovery file is kept outside the repo.
CIRCLE_ENTITY_SECRET=
CIRCLE_AGENT_WALLET_ID=
# Agent SCA address (public): the `agent` role on every vault; the web app reads it to deploy vaults.
CIRCLE_AGENT_WALLET_ADDRESS=
# circle (default when the Circle values are set) | eoa (testnet fallback using AGENT_PRIVATE_KEY).
AGENT_BACKEND=
# Testnet-only EOA: decision signer and executor fallback. Never use on mainnet.
AGENT_PRIVATE_KEY=

# ─── Judge (Anthropic) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AGENT_MODEL_JUDGE=claude-haiku-4-5-20251001

# ─── X (API v2 pay-per-use + OAuth 2.0 PKCE) ───────────────────────────
# OAuth 2.0 client (type "Web App"), callback: <NEXT_PUBLIC_APP_URL>/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# App-only bearer token for GET /2/tweets/:id lookups.
X_BEARER_TOKEN=

# ─── GitHub ─────────────────────────────────────────────────────────────
# Fine-grained read-only token for pull request and commit lookups (public repos).
GITHUB_TOKEN=

# ─── Worker ─────────────────────────────────────────────────────────────
# Parallel submission jobs per worker (1-8, default 2). Rounds always run one at a time.
WORKER_CONCURRENCY=

# ─── Contracts (Foundry scripts) ───────────────────────────────────────
# Testnet-only deployer key for `forge script` and scripts that act as the owner in live checks.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Set to true only with explicit owner sign-off to allow Deploy.s.sol on Arc mainnet.
ALLOW_MAINNET=

# ─── Tests (optional) ──────────────────────────────────────────────────
# ARC_FORK_RPC=https://rpc.testnet.arc.io  → enables the Foundry fork tests
# ARC_RPC_TESTS=1                          → enables live Arc signature tests in Vitest
