{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/worker/Dockerfile",
    "watchPatterns": [
      "apps/worker/**",
      "packages/agent/**",
      "packages/db/**",
      "packages/shared/**",
      "pnpm-lock.yaml",
      "railway.json"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS",
    "sleepApplication": false,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120
  }
}
