{
  "name": "@misthos/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "prettier --check src test",
    "start:local": "tsx --env-file=../../.env src/index.ts",
    "circle:setup": "tsx --env-file=../../.env scripts/circle-setup.ts",
    "circle:probe": "tsx --env-file=../../.env scripts/circle-probe.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@circle-fin/developer-controlled-wallets": "^10.8.1",
    "@misthos/agent": "workspace:*",
    "@misthos/db": "workspace:*",
    "@misthos/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg-boss": "^12.35.1",
    "pino": "^10",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4"
  }
}
